#!/usr/bin/env bash
set -euo pipefail
pidfile=/data/raft-sqlite.pid
NODE_ID=$(cat /etc/raftz-node-id)
alive() {
  [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null &&
    [[ $(cat "/proc/$(cat "$pidfile")/comm") == raft-sqlite ]] &&
    ! grep -q '^State:.*Z' "/proc/$(cat "$pidfile")/status"
}
case "${1:-}" in
  start)
    if alive; then exit 0; fi
    peers=()
    for i in 1 2 3; do
      ip=$(getent ahostsv4 "n$i" | awk 'NR==1 {print $1}')
      [[ -n "$ip" ]]
      peers+=(--peer "$i=$ip:9001")
    done
    ip=$(getent ahostsv4 "n${NODE_ID}" | awk 'NR==1 {print $1}')
    nohup /usr/local/bin/raft-sqlite serve --node-id "$NODE_ID" \
      --cluster-id 0198f54d-5c2a-7000-8000-000000000001 \
      --api-listen 0.0.0.0:8001 --raft-listen 0.0.0.0:9001 \
      --raft-advertise "$ip:9001" --data-dir /data "${peers[@]}" \
      >>/data/raft-sqlite.log 2>&1 </dev/null &
    echo $! > "$pidfile"
    sleep 1
    if ! alive; then tail -30 /data/raft-sqlite.log >&2; exit 1; fi
    ;;
  kill)
    alive
    kill -KILL "$(cat "$pidfile")"
    rm -f "$pidfile"
    ;;
  stop)
    if alive; then
      kill -TERM "$(cat "$pidfile")"
      for ((i=0; i<100; i++)); do
        if ! alive; then break; fi
        sleep 0.1
      done
      if alive; then kill -KILL "$(cat "$pidfile")"; fi
    fi
    rm -f "$pidfile"
    ;;
  partition)
    iptables -w -A INPUT -p tcp --dport 9001 -j DROP
    iptables -w -A INPUT -p tcp --sport 9001 -j DROP
    iptables -w -A OUTPUT -p tcp --dport 9001 -j DROP
    iptables -w -A OUTPUT -p tcp --sport 9001 -j DROP
    iptables -w -S
    ;;
  heal)
    iptables -w -F INPUT
    iptables -w -F OUTPUT
    ;;
  *) echo 'usage: node-control start|kill|stop|partition|heal' >&2; exit 2 ;;
esac
