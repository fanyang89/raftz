#!/usr/bin/env bash
#MISE description="Check real reads and register results against consensus, application, and client-history models"
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
mkdir -p .cache/tla
zig build test-tla-trace --summary all
PYTHONDONTWRITEBYTECODE=1 python3 formal/read_trace_check.py \
  .cache/tla/read-batch.ndjson .cache/tla/read-partition.ndjson --negatives "$@"
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s formal -p 'test_*.py'
